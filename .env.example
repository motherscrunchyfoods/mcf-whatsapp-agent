# ============================================================
# MCF WhatsApp Agent (Maya) - Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# ─── AI API - Sirf EK chahiye ─────────────────────────────

# 🆓 Option 1: GROQ (FREE - RECOMMENDED!)
# Sign up: https://console.groq.com
# Daily limit: ~14,400 requests (kaafi hai!)
GROQ_API_KEY=gsk_your_groq_key_here

# 🆓 Option 2: Google Gemini (FREE tier)
# Get key: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_key_here

# 💰 Option 3: Anthropic Claude (Paid, best quality)
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# AI Model (optional override)
# AI_MODEL=llama-3.3-70b-versatile  # Groq default
# AI_MODEL=gemini-1.5-flash          # Gemini default

# ─── Meta WhatsApp Cloud API (100% BAN-FREE, Official) ────
# Setup: https://developers.facebook.com
# Free: 1000 conversations/month

# Meta Developer Console > Your App > WhatsApp > API Setup
WHATSAPP_TOKEN=your_meta_access_token_here
PHONE_NUMBER_ID=your_phone_number_id_here

# Koi bhi secret string rakho (verify karne ke liye)
VERIFY_TOKEN=mcf_maya_2024

# ─── Server ───────────────────────────────────────────────
PORT=3000
